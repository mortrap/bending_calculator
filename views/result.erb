<body>
    <div class = "container">
        <h2> Result </h2>
        <div class = "result">
            <span class="result">Result sweep</span> =
            <span style = "color: <%= @result.is_a?(String) && @result.start_with?('Error') ? 'red': 'green'%>;">
                <%= @result_sweep %>
            </span>
            <span class="result">Result effort</span> =
            <span style = "color: <%= @result.is_a?(String) && @result.start_with?('Error') ? 'red': 'green'%>;">
                <%= @result_effort %>
            </span>
        </div>
        <div>
            <a href="javascript:history.back(1)">continue</a>
        </div>
        <div>
            <a href="/unset_id">refresh session</a>
        </div>
    </div>
</body>